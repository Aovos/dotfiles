[global]
    monitor = 0
    follow = mouse
    width = (250, 450)
    origin = top-right
    offset = (10, 10)

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 400
    progress_bar_corner_radius = 3

    indicate_hidden = yes
    shrink = no

    separator_height = 2
    separator_color = "#11111b"

    padding = 15
    horizontal_padding = 15

    frame_width = 2
    corner_radius = 20

    sort = yes
    idle_threshold = 120

    font = jetbrains-mono 10
    line_height = 0

    markup = full
    format = "<span weight='bold' size='large'>%s</span>\n%b"

    alignment = left
    vertical_alignment = center

    show_age_threshold = 60

    word_wrap = yes
    ellipsize = middle
    ignore_newline = no

    stack_duplicates = true
    hide_duplicate_count = false

    show_indicators = no

    icon_position = left
    min_icon_size = 28
    max_icon_size = 40

    icon_path = /home/soto/.icons/myicons:/run/current-system/sw/share/icons/Papirus/48x48/status:/run/current-system/sw/share/icons/Papirus/48x48/devices

    sticky_history = yes
    history_length = 20

    always_run_script = true

    title = Dunst
    class = Dunst

    ignore_dbusclose = false
    force_xwayland = false
    force_xinerama = false

    mouse_left_click = do_action, close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#00000080"
    foreground = "#e0e0e0"
    highlight = "#e0e0e0"
    frame_color = "#333333"
    timeout = 5

[urgency_normal]
    background = "#00000080"
    foreground = "#e0e0e0"
    highlight = "#e0e0e0"
    frame_color = "#333333"
    timeout = 7

[urgency_critical]
    background = "#00000080"
    foreground = "#e0e0e0"
    frame_color = "#FF00FF"
    timeout = 0

[volume]
    appname = "Volume"
    highlight = "#cba6f7"

[backlight]
    appname = "Backlight"
    highlight = "#eba0ac"

# vim: ft=cfg
