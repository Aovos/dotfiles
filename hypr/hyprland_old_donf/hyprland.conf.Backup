# hyprctl reload -> Reloading Hyprland, without restart

################
### MONITORS ###
################

monitor = eDP-1,1920x1080@144,0x0,1
#

###################
### MY PROGRAMS ###
###################

$terminal 		= alacritty
$fileManager 	= nemo
$menu 			= rofi -show drun

#################
### AUTOSTART ###
#################

exec-once = hyprpaper
exec-once = hypridle
exec-once = systemctl --user start hyprpolkitagent
exec-once = hyprctl setcursor McMojave-cursors 24

#############################
### ENVIRONMENT VARIABLES ###
#############################

env = GTK_ICON_THEME,Papirus-Dark
env = XCURSOR_THEME,McMojave-cursors
env = XCURSOR_SIZE,24
env = HYPRCURSOR_THEME,McMojave-cursors
env = HYPRCURSOR_SIZE,24

#####################
### LOOK AND FEEL ###
#####################

general {
    gaps_in = 5
    gaps_out = 50

    border_size = 2

    col.active_border = rgba(333333aa) #rgba(4d4d4dff)
    col.inactive_border = rgba(333333aa)

    layout = dwindle
}

decoration {
    rounding = 20
    rounding_power = 2

    active_opacity = 1.0
    inactive_opacity = 1.0

	blur {
        enabled = true
        size = 3
        passes = 1

        vibrancy = 0.1696
    }

    shadow {
        enabled = false
        range = 4
        render_power = 3
        color = rgba(333333aa)
    }
}

animations {

    enabled = yes, please :)

    bezier = easeOutQuint,0.23,1,0.32,1
    bezier = easeInOutCubic,0.65,0.05,0.36,1
    bezier = linear,0,0,1,1
    bezier = almostLinear,0.5,0.5,0.75,1.0
    bezier = quick,0.15,0,0.1,1

    animation = global, 1, 10, default
    animation = border, 1, 5.39, easeOutQuint
    animation = windows, 1, 4.79, easeOutQuint
    animation = windowsIn, 1, 4.1, easeOutQuint, popin 87%
    animation = windowsOut, 1, 1.49, linear, popin 87%
    animation = fadeIn, 1, 1.73, almostLinear
    animation = fadeOut, 1, 1.46, almostLinear
    animation = fade, 1, 3.03, quick
    animation = layers, 1, 3.81, easeOutQuint
    animation = layersIn, 1, 4, easeOutQuint, fade
    animation = layersOut, 1, 1.5, linear, fade
    animation = fadeLayersIn, 1, 1.79, almostLinear
    animation = fadeLayersOut, 1, 1.39, almostLinear
    animation = workspaces, 1, 1.94, almostLinear, fade
    animation = workspacesIn, 1, 1.21, almostLinear, fade
    animation = workspacesOut, 1, 1.94, almostLinear, fade
}

#dwindle {
#    pseudotile = true # Master switch for pseudotiling. Enabling is bound to mainMod + P in the keybinds section below
#    preserve_split = true # You probably want this
#}

master {
    new_status = master
}

misc {
    force_default_wallpaper = -1 # Set to 0 or 1 to disable the anime mascot wallpapers
    disable_hyprland_logo = false # If true disables the random hyprland logo / anime girl background. :(
}

#############
### INPUT ###
#############

input {
    kb_layout = de
    kb_variant =
    kb_model =
    kb_options =
    kb_rules =

    follow_mouse = 1

    sensitivity = 0 # -1.0 - 1.0, 0 means no modification.

    touchpad {
        natural_scroll = true
        disable_while_typing = false
    }
}

gestures {
    gesture = 3, horizontal, workspace
}

###################
### KEYBINDINGS ###
###################

$mainMod = SUPER

# Mausrad-Navigation
bind = $mainMod, mouse_up, workspace, e-1
bind = $mainMod, mouse_down, workspace, e+1

bind = $mainMod, Return, exec, $terminal
bind = $mainMod, R, exec, $menu
#bind = $mainMod, dead_circumflex, exec, $menu
bind = $mainMod, Q, killactive,
bind = $mainMod, F, togglefloating
bind = $mainMod, V, fullscreen
bind = $mainMod, L, exec, hyprlock

# Floating & Pinning Window
bind = $mainMod, P, togglefloating
bind = $mainMod, P, pin

# For Reading Code
bind = $mainMod, C, resizeactive, exact 820 1020
bind = $mainMod, C, centerwindow

# Screenshot
bind = , Print, exec, grim -g "$(slurp)" ~/Desktop/screenshot_$(date +'%Y-%m-%d_%H-%M-%S').png
bind = SHIFT, Print, exec, grim -g "$(slurp)" - | satty --filename -

# Move focus with mainMod + arrow keys
bind = $mainMod, left, movefocus, l
bind = $mainMod, right, movefocus, r
bind = $mainMod, up, movefocus, u
bind = $mainMod, down, movefocus, d

# Fenster verschieben
bind = SUPER SHIFT, left,  movewindow, l
bind = SUPER SHIFT, right, movewindow, r
bind = SUPER SHIFT, up,    movewindow, u
bind = SUPER SHIFT, down,  movewindow, d

# Switch workspaces with mainMod + [0-9]
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
bind = $mainMod, 6, workspace, 6
bind = $mainMod, 7, workspace, 7
bind = $mainMod, 8, workspace, 8
bind = $mainMod, 9, workspace, 9
bind = $mainMod, 0, workspace, 10

# Move active window to a workspace with mainMod + SHIFT + [0-9]
bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5
bind = $mainMod SHIFT, 6, movetoworkspace, 6
bind = $mainMod SHIFT, 7, movetoworkspace, 7
bind = $mainMod SHIFT, 8, movetoworkspace, 8
bind = $mainMod SHIFT, 9, movetoworkspace, 9
bind = $mainMod SHIFT, 0, movetoworkspace, 10

# Example special workspace (scratchpad)
bind = $mainMod, plus, togglespecialworkspace, magic
bind = $mainMod SHIFT, plus, movetoworkspace, special:magic

# Move/resize windows with mainMod + LMB/RMB and dragging
bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod SHIFT, mouse:272, resizewindow

# Laptop multimedia keys for volume and LCD brightness
bindel = ,XF86AudioRaiseVolume, exec, wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindel = ,XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindel = ,XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindel = ,XF86AudioMicMute, exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindel = ,XF86MonBrightnessUp, exec, brightnessctl -e4 -n2 set 5%+
bindel = ,XF86MonBrightnessDown, exec, brightnessctl -e4 -n2 set 5%-

# Requires playerctl
bindl = , XF86AudioNext, exec, playerctl next
bindl = , XF86AudioPause, exec, playerctl play-pause
bindl = , XF86AudioPlay, exec, playerctl play-pause
bindl = , XF86AudioPrev, exec, playerctl previous

####################
### WINDOW RULES ###
####################

# "hyprctl clients" -> Namen der Anwendung herauszufinden

# Alacritty
windowrule {
    name = float-alacritty
    float = true
    size = "600 400"
    match:class = ^(Alacritty)$
    match:title = ^(Alacritty)$
}

# Firefox Picture-in-Picture
windowrule {
    name = firefox-pip
    float = true
    pin = true
    match:class = ^(firefox)$
    match:title = ^(Picture-in-Picture)$
}

# MPV
windowrule {
    name = float-mpv
    float = true
    match:class = ^(mpv)$
}

# Feh
windowrule {
    name = float-feh
    float = true
    match:class = ^(feh)$
}

# Blueman Manager
windowrule {
    name = blueman-manager
    float = true
    center = true
    size = "600 400"
    match:class = ^(\.blueman-manager-wrapped)$
}

# Pavucontrol
windowrule {
    name = pavucontrol-center
    float = true
    center = true
    size = "900 500"
    match:class = ^(org\.pulseaudio\.pavucontrol)$
}

# Songrec
windowrule {
    name = songrec-center
    float = true
    center = true
    size = "1400 800"
    match:class = ^(songrec)$
}

# Tenacity
windowrule {
    name = tenacity-center
    float = true
    center = true
    size = "1600 600"
    match:class = ^(tenacity)$
}

# GParted
windowrule {
    name = gparted-center
    float = true
    center = true
    size = "900 600"
    match:class = ^(GParted)$
}

# MissionCenter
windowrule {
    name = missioncenter-center
    float = true
    center = true
    size = "1400 900"
    match:class = ^(io\.missioncenter\.MissionCenter)$
}



#########################
### WORKSPACES RUKLES ###
#########################

# Workspace 1: Web
windowrule = match:class ^(firefox)$, workspace 1 silent

# Workspace 2: Mail
windowrule = match:class ^(thunderbird)$, workspace 2 silent

# Workspace 3: Chat
windowrule = match:class ^(discord)$, workspace 3 silent
windowrule = match:class ^(Signal)$, workspace 3 silent

# Workspace 4: Files
windowrule = match:class ^(nemo)$, workspace 4 silent

# Workspace 5: Audio
windowrule = match:class ^(Spotify|audacious)$, workspace 5 silent

# Workspace 6: AV-Editing / Recording
windowrule = match:class ^(com.obsproject.Studio)$, workspace 6 silent
windowrule = match:class ^(tenacity)$, workspace 6 silent

# Workspace 7: Gaming
windowrule = match:class ^(steam)$, workspace 7 silent

# Workspace 8: Code
windowrule = match:class ^(codium)$, workspace 8 silent

# Workspace 9: Notes (Nutzt initial_title in Snake-Case)
windowrule = match:initial_title ^(marktext)$, workspace 9 silent

# Workspace 10: Productivity
windowrule = match:class ^(superProductivity)$, workspace 10 silent



# Maximiere-Anfragen von Apps blockieren (Neue Syntax)
windowrule = match:class .*, suppress_event maximize

# XWayland Dropdown-/Kontextmenü-Fix (Neue Syntax)
windowrule = match:class ^$, match:title ^$, match:xwayland true, match:float true, match:fullscreen false, match:pin false, no_focus true
